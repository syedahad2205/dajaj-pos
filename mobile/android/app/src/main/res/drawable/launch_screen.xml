<?xml version="1.0" encoding="utf-8"?>
<!-- DAJAJ Finance launch screen — cream background with centered brand icon -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cream background -->
    <item>
        <color android:color="@color/dajaj_cream" />
    </item>

    <!-- Brand "D" icon centered — scales to 25% of screen width -->
    <item
        android:gravity="center"
        android:width="80dp"
        android:height="80dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dajaj_red" />
            <corners android:radius="18dp" />
        </shape>
    </item>

</layer-list>
