<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Button Styles =====
         All buttons meet 48dp minimum touch target.
         Large text for restaurant POS readability.
    -->

    <!-- Primary filled button (main action) -->
    <style name="Widget.DajajPOS.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
        <item name="android:textSize">@dimen/text_size_body_large</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <!-- Secondary outlined button -->
    <style name="Widget.DajajPOS.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
        <item name="android:textSize">@dimen/text_size_body_large</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <!-- Text button (tertiary action) -->
    <style name="Widget.DajajPOS.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
        <item name="android:textSize">@dimen/text_size_body_large</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Icon button (round, for cart +/- actions) -->
    <style name="Widget.DajajPOS.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:minWidth">@dimen/touch_target_min</item>
    </style>

    <!-- ===== Card Styles ===== -->

    <!-- Standard elevated card -->
    <style name="Widget.DajajPOS.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="contentPadding">@dimen/padding_md</item>
    </style>

    <!-- Outlined card (for list items) -->
    <style name="Widget.DajajPOS.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="contentPadding">@dimen/padding_md</item>
    </style>

    <!-- ===== Text Appearance Styles =====
         Larger sizes for POS readability at arm's length.
         WCAG AA: 4.5:1 contrast with theme backgrounds.
    -->

    <style name="TextAppearance.DajajPOS.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_size_headline_large</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.DajajPOS.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_size_headline_medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.DajajPOS.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_size_headline_small</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.DajajPOS.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_size_title_large</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.DajajPOS.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_size_title_medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.DajajPOS.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_size_body_large</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.DajajPOS.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_body_medium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.DajajPOS.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_size_label_large</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.DajajPOS.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_size_label_medium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ===== Status Chip Styles ===== -->

    <!-- Success chip (green background, like web "available" badges) -->
    <style name="Widget.DajajPOS.Chip.Success" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/action_success_container</item>
        <item name="android:textColor">@color/action_success</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:textSize">@dimen/text_size_label_medium</item>
    </style>

    <!-- Danger chip (red background, like web "out of stock" badges) -->
    <style name="Widget.DajajPOS.Chip.Danger" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/action_danger_container</item>
        <item name="android:textColor">@color/action_danger</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:textSize">@dimen/text_size_label_medium</item>
    </style>

    <!-- ===== Input Field Styles ===== -->

    <style name="Widget.DajajPOS.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/card_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/card_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/card_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/card_corner_radius</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <!-- ===== Empty State Styles ===== -->

    <style name="TextAppearance.DajajPOS.EmptyState" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_size_body_large</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- ===== Toolbar Style ===== -->

    <style name="Widget.DajajPOS.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.DajajPOS.TitleLarge</item>
        <item name="android:elevation">0dp</item>
        <item name="android:background">?attr/colorSurface</item>
    </style>
</resources>
