<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 Shape Theme for DajajPOS
         Defines corner radius values for various component sizes.
    -->

    <!-- Shape Corner Sizes -->
    <dimen name="shape_corner_none">0dp</dimen>
    <dimen name="shape_corner_extra_small">4dp</dimen>
    <dimen name="shape_corner_small">8dp</dimen>
    <dimen name="shape_corner_medium">12dp</dimen>
    <dimen name="shape_corner_large">16dp</dimen>
    <dimen name="shape_corner_extra_large">28dp</dimen>
    <dimen name="shape_corner_full">50dp</dimen>

    <!-- Shape Appearance Styles -->

    <!-- Extra Small: Chips, small badges -->
    <style name="ShapeAppearance.DajajPOS.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">@dimen/shape_corner_extra_small</item>
    </style>

    <!-- Small: Text fields, list items -->
    <style name="ShapeAppearance.DajajPOS.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/shape_corner_small</item>
    </style>

    <!-- Medium: Cards, dialogs -->
    <style name="ShapeAppearance.DajajPOS.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/shape_corner_medium</item>
    </style>

    <!-- Large: Bottom sheets, navigation drawers, cards -->
    <style name="ShapeAppearance.DajajPOS.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/shape_corner_large</item>
    </style>

    <!-- Extra Large: Large bottom sheets, modals -->
    <style name="ShapeAppearance.DajajPOS.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">@dimen/shape_corner_extra_large</item>
    </style>

    <!-- Full: FABs, circular buttons -->
    <style name="ShapeAppearance.DajajPOS.Full" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">@dimen/shape_corner_full</item>
    </style>
</resources>
