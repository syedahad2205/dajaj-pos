<?xml version="1.0" encoding="utf-8"?>
<!-- Full content-area error state component.
     Shows an error icon, message, and retry button.
     All touch targets meet ≥48dp minimum.
     Usage: <include layout="@layout/layout_error_state" />
     Toggle visibility and set message/action programmatically.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/errorStateRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/padding_xl"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- Error icon -->
    <ImageView
        android:id="@+id/errorStateIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/content_desc_error_icon"
        android:importantForAccessibility="yes"
        app:srcCompat="@drawable/ic_error_outline"
        app:tint="?attr/colorError" />

    <!-- Error title -->
    <TextView
        android:id="@+id/errorStateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_md"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.DajajPOS.Title.Large"
        android:textColor="?attr/colorOnSurface"
        tools:text="Something went wrong" />

    <!-- Error description -->
    <TextView
        android:id="@+id/errorStateMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_sm"
        android:gravity="center"
        android:maxWidth="320dp"
        android:textAppearance="@style/TextAppearance.DajajPOS.Body.Medium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="We couldn't load the data. Please check your connection and try again." />

    <!-- Retry button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/errorStateRetryButton"
        style="@style/Widget.DajajPOS.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_lg"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/action_retry"
        app:icon="@drawable/ic_refresh" />

</LinearLayout>
