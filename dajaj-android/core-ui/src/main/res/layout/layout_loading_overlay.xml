<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen semi-transparent loading overlay.
     Shows a CircularProgressIndicator centered on screen.
     Usage: Include in your layout and toggle visibility.
     Default: android:visibility="gone"
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loadingOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_background"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/padding_lg">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loadingProgressIndicator"
            android:layout_width="@dimen/loading_indicator_size"
            android:layout_height="@dimen/loading_indicator_size"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="?attr/colorSurfaceVariant"
            app:trackThickness="4dp" />

        <TextView
            android:id="@+id/loadingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_md"
            android:textAppearance="@style/TextAppearance.DajajPOS.BodyLarge"
            android:textColor="@android:color/white"
            tools:text="Creating order..." />

    </LinearLayout>

</FrameLayout>
