<?xml version="1.0" encoding="utf-8"?>
<!--
    Horizontal category chip for portrait mode.
    Each chip is a pill-shaped button that scrolls horizontally.
    Selected state: filled orange (#C45100 bg, white text)
    Normal state: white bg, slate-700 text, slate-200 border
-->
<TextView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvCategoryChip"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:layout_marginHorizontal="4dp"
    android:gravity="center"
    android:paddingHorizontal="16dp"
    android:textSize="13sp"
    android:textStyle="bold"
    android:background="@drawable/selector_category_chip"
    android:textColor="@drawable/selector_category_chip_text"
    android:clickable="true"
    android:focusable="true"
    android:singleLine="true"
    android:ellipsize="none" />
