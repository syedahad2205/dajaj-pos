rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // AUTH MODEL
    // ─────────────────────────────────────────────────────────────────────────
    // ADMIN     — Firebase Auth (email). isAdmin() checks /admins/{uid}.
    //
    // POS STAFF — Firebase Auth (email). Created on first login after approval.
    //             isActivePosStaff() checks /pos_staff/{email}.status == active.
    //             isInventoryManager() checks /pos_staff/{email}.canManageInventory == true.
    //             Docs are keyed by lowercase email (not UID).
    //
    // CUSTOMER  — No Firebase Auth. Phone + OTP session in localStorage.
    //
    // RIDER     — No Firebase Auth. riderId + access code in localStorage.
    //
    // FINANCE USER — No Firebase Auth. Managed by admins in finance_auth via
    //             the web app; will authenticate from the future React
    //             Native Daily Closing app via a username/password check
    //             against a bcrypt hash (services/financeUsersService.ts).
    //             Entirely separate from admin/POS/customer/rider auth.
    //
    // FINANCE MANAGER — Firebase Auth (email), same login as Admin at
    //             /admin/login. isFinanceManager() checks /finance_managers/{uid}.
    //             Scoped ONLY to Finance Dashboard, Daily Closing, Transactions,
    //             and Reports — never POS/Inventory/Riders/Zomato/Orders/
    //             Feedback, and never Finance Settings (Accounts, Vendors,
    //             Categories, Finance Users, Locks all stay Admin-only). This
    //             is a different concept from FINANCE USER above — do not
    //             conflate finance_managers with finance_auth.
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdminSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function posStaffPath() {
      return /databases/$(database)/documents/pos_staff/$(request.auth.token.email.lower());
    }

    function isActivePosStaff() {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(posStaffPath())
        && get(posStaffPath()).data.status == 'active';
    }

    function isInventoryManager() {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(posStaffPath())
        && get(posStaffPath()).data.status == 'active'
        && get(posStaffPath()).data.canManageInventory == true;
    }

    function isAdminOrPosStaff() {
      return isAdmin() || isActivePosStaff();
    }

    function isAdminOrInventoryManager() {
      return isAdmin() || isInventoryManager();
    }

    function isFinanceUser() {
      return isSignedIn()
        && request.auth.token.financeUser == true
        && exists(/databases/$(database)/documents/finance_auth/$(request.auth.uid))
        && get(/databases/$(database)/documents/finance_auth/$(request.auth.uid)).data.active == true;
    }

    // Restricted Finance web role — a real Firebase Auth account (unlike
    // isFinanceUser() above) scoped to only the Finance collections this file
    // explicitly grants below. Absence of `active` on the doc means active,
    // matching a record created manually via the Firebase Console with no
    // active field set at all.
    function isFinanceManager() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/finance_managers/$(request.auth.uid))
        && get(/databases/$(database)/documents/finance_managers/$(request.auth.uid)).data.active != false;
    }

    function isAdminOrFinanceManager() {
      return isAdmin() || isFinanceManager();
    }

    // ── Admin Profiles ────────────────────────────────────────────────────────
    // A Firebase Auth user may read their OWN doc (needed during login to verify
    // admin status). Any existing admin may read/write other admin docs.
    match /admins/{adminId} {
      allow read:  if isAdminSelf(adminId) || isAdmin();
      allow write: if isAdmin();
    }

    // ── Finance Manager Profiles ──────────────────────────────────────────────
    // Same self-read-or-admin pattern as /admins above. Only an Admin may
    // create/disable/remove a Finance Manager — a Finance Manager can never
    // grant themselves or anyone else this role.
    match /finance_managers/{managerId} {
      allow read:  if isAdminSelf(managerId) || isAdmin();
      allow write: if isAdmin();
    }

    // ── POS Staff ─────────────────────────────────────────────────────────────
    // Doc ID = lowercase email. Anyone signed in may create their OWN request
    // (status will be 'pending'). Only admins may approve/reject and manage inventory permissions.
    // A signed-in user may read their own doc to check approval status.
    match /pos_staff/{email} {
      // Public read — it's just approval status, no sensitive data.
      // Also needed for the pre-auth first-login check.
      allow read: if true;

      // Unauthenticated create for pending request submissions (no auth account yet)
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.email == email;

      // Signed-in POS user may update their own doc (e.g. to store uid on first login)
      allow update: if isSignedIn()
                    && request.auth.token.email != null
                    && request.auth.token.email.lower() == email;

      // Admin has full access including inventory permission management
      allow write: if isAdmin();
    }

    // ── POS Open Orders ───────────────────────────────────────────────────────
    // Internal POS tablet. Requires admin or active POS staff session.
    match /pos_open_orders/{orderId} {
      allow read, write: if isAdminOrPosStaff();
    }

    // ── Bills ─────────────────────────────────────────────────────────────────
    // Read is public — bills are shared with customers via a WhatsApp link
    // containing a UUID publicToken. Token validation is done in the app;
    // Firestore allows the read so the app can perform the check.
    // POS staff may create bills and delete them when reopening a bill for edit
    // (reopenBillAsOrder deletes the old bill after copying to pos_open_orders).
    match /bills/{billId} {
      allow read:           if true;
      allow create:         if isAdminOrPosStaff();
      allow update, delete: if isAdminOrPosStaff();
    }

    // ── Counters ──────────────────────────────────────────────────────────────
    // counters/orders — incremented during online checkout (no Firebase Auth).
    //   Transaction must read before it can write, so read must be public too.
    // counters/bills  — incremented during POS bill generation (admin or POS staff).
    match /counters/{counterId} {
      allow read, write: if isAdminOrPosStaff() || counterId == 'orders';
    }

    // ── Online Orders ─────────────────────────────────────────────────────────
    // Customers (no Firebase Auth) create orders from checkout.
    // Admin and riders manage status. Riders have no Firebase Auth, so
    // update is kept open (enforced by app-level session checks).
    match /orders/{orderId} {
      allow create, read: if true;
      allow update:       if true;   // admin + rider status updates (app-enforced)
      allow delete:       if isAdmin();
    }

    // ── OTP Verifications ─────────────────────────────────────────────────────
    // Written and read by Next.js API routes using the client SDK (no request.auth).
    // Records are short-lived (5 min TTL) and contain only a phone + OTP hash.
    match /otp_verifications/{phone} {
      allow read, write, delete: if true;
    }

    // ── Customer Profiles ─────────────────────────────────────────────────────
    // Phone number is the document ID. No Firebase Auth — identity is enforced
    // at the app layer (WhatsApp OTP session in localStorage).
    match /customers/{customerPhone} {
      allow read, create, update: if true;
      allow delete:               if isAdmin();

      match /addresses/{addressId} {
        allow read, write, delete: if true;
      }
    }

    // ── Riders ────────────────────────────────────────────────────────────────
    // Admin creates and deactivates rider accounts.
    // Rider app reads its own profile and writes live location / availability.
    // No Firebase Auth on the rider side — app enforces session.
    match /riders/{riderId} {
      allow read:           if true;
      allow create, delete: if isAdmin();
      allow update:         if true;   // rider updates location / availability
    }

    // ── Delivery Assignments ──────────────────────────────────────────────────
    // Admin creates and cancels assignments.
    // Rider reads assigned jobs and updates delivery status (no Firebase Auth).
    match /delivery_assignments/{assignmentId} {
      allow read:           if true;
      allow create, delete: if isAdmin();
      allow update:         if true;   // rider updates delivery status
    }

    // ── Order Tracking ────────────────────────────────────────────────────────
    // Rider writes live GPS position; customer reads on the tracking page.
    // Neither has Firebase Auth.
    match /order_tracking/{orderId} {
      allow read, write: if true;
    }

    // ── Menu ──────────────────────────────────────────────────────────────────
    // Public read for online menu page and POS item picker.
    // Only admin can modify the menu tree.
    match /menus/{menuId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Stock Control ──────────────────────────────────────────────────────────
    // Public read so the /menu page can show out-of-stock status.
    // Only admin or inventory managers can toggle stock availability.
    match /stock_control/{docId} {
      allow read:  if true;
      allow write: if isAdminOrInventoryManager();
    }

    // ── Modifier Masters ──────────────────────────────────────────────────────
    // Public read for menu page modifier resolution.
    // Only admin can create/manage global modifier definitions.
    match /modifier_masters/{masterId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Inventory Masters ─────────────────────────────────────────────────────
    // Shared inventory entities derived from menu data.
    // Public read for dependency resolution. Admin-only write.
    match /inventory_masters/{masterId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Delivery Settings ─────────────────────────────────────────────────────
    // Public read for delivery fee calculation on the checkout page.
    // Only admin can configure zones and minimum order.
    match /deliverySettings/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Inventory Entries ─────────────────────────────────────────────────────
    // Daily inventory stock entries (opening/closing stock).
    // Admin has full access. Active POS staff with inventory permission can read/write.
    match /inventory_entries/{entryId} {
      allow read, write: if isAdmin();
      allow read, write: if isInventoryManager();
    }

    // ── Inventory Audit Logs ──────────────────────────────────────────────────
    // Complete audit trail of all inventory changes.
    // Admin can read and manage all logs. Inventory managers may create audit
    // records for their own stock changes and review the log history.
    match /inventory_audit_logs/{logId} {
      allow read:           if isAdmin() || isInventoryManager();
      allow create:         if isAdminOrInventoryManager();
      allow update, delete: if isAdmin();
    }

    // ── Zomato Sales Tracker ──────────────────────────────────────────────────
    // Admin-only: import payout CSVs, view analytics, manage history.
    match /zomato_imports/{docId} {
      allow read, write: if isAdmin();
    }

    match /zomato_item_sales/{docId} {
      allow read, write: if isAdmin();
    }

    match /zomato_category_summary/{docId} {
      allow read, write: if isAdmin();
    }

    match /zomato_item_summary/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Customer Feedback ─────────────────────────────────────────────────────
    // Customers sign in with Google (Firebase Auth) to submit feedback.
    // They can only create their own record — no reading or editing after submit.
    // Admins have full access for the feedback management screen.
    match /feedback/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.source == "qr-feedback";
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // FINANCE MODULE — single source of truth for all money movement.
    // Admin has full access everywhere below. Finance Manager (see AUTH MODEL
    // above) is granted read+write only on the collections Daily Closing,
    // Transactions, Dashboard, and Reports actually need, and read-only on
    // reference/lookup collections — never write access to categories,
    // vendors, or anything else that's a Finance Settings concern.
    // All collections are prefixed fin_. Transactions are treated as an
    // append-mostly immutable ledger — voids are soft (status flips to 'void',
    // never deleted) so history/audit trail stays intact.
    // =========================================================================

    // Read+write for Finance Manager too — needed to post transactions and
    // Daily Closing sales/deposits, which update account balances.
    match /fin_accounts/{accountId} {
      allow read, write: if isAdminOrFinanceManager();
    }

    // Finance Manager gets read-only here — populating dropdowns on
    // Daily Closing/Transactions, never creating/editing a category, which
    // stays a Finance Settings (Admin-only) action.
    match /fin_expense_categories/{categoryId} {
      allow read: if isAdmin() || isFinanceUser() || isFinanceManager();
      allow write: if isAdmin();
    }

    match /fin_expense_subcategories/{subcategoryId} {
      allow read: if isAdmin() || isFinanceManager();
      allow write: if isAdmin();
    }

    match /fin_income_categories/{categoryId} {
      allow read: if isAdmin() || isFinanceManager();
      allow write: if isAdmin();
    }

    match /fin_vendors/{vendorId} {
      allow read: if isAdmin() || isFinanceManager();
      allow write: if isAdmin();
    }

    // Finance Defaults — maps a business event (Cash Sales, UPI Sales, a
    // Pigmi Deposit, ...) to the account it should automatically post
    // into when Daily Closing is saved. Deliberately not prefixed fin_
    // per the original spec for this collection.
    match /finance_defaults/{eventKey} {
      allow read: if isAdmin() || isFinanceUser() || isFinanceManager();
      allow write: if isAdmin();
    }

    // Ledger records are immutable once created except for the status/void
    // fields — enforced at the service layer via runTransaction. Rules stay
    // admin-or-finance-manager; field-level immutability is an app-layer
    // guarantee here since Admin SDK-style granular rule checks would
    // require duplicating the whole transaction shape in rules.
    match /fin_transactions/{transactionId} {
      allow read, write: if isAdminOrFinanceManager();
    }

    match /fin_daily_closing/{closingId} {
      allow read: if isAdminOrFinanceManager() || isFinanceUser();
      allow write: if isAdminOrFinanceManager();
    }

    // ── Finance Mobile Idempotency ────────────────────────────────────────────
    // Written by the React Native Daily Closing app's identity-forwarding
    // mutation routes to record replay results for a given idempotency key.
    // Finance Users only — admins do not use this collection.
    match /fin_mobile_idempotency/{docId} {
      allow read, write: if isFinanceUser();
    }

    // Append-only audit trail. Admin may read/create; Finance Manager may
    // create (so their own actions still get logged) but never read the
    // trail back. Nothing may ever be updated or deleted so the trail can't
    // be tampered with after the fact.
    match /fin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdminOrFinanceManager();
      allow update, delete: if false;
    }

    match /fin_settings/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Finance Users (finance_auth) ──────────────────────────────────────────
    // Auth infrastructure for the future React Native Daily Closing app.
    // Completely separate from /admins — Finance Users have no Firebase Auth
    // account, so request.auth is never a Finance User here. Only an admin
    // (managing this from the web app) may read/write, which also means
    // password hashes are never exposed to an unauthenticated client.
    match /finance_auth/{financeUserId} {
      allow read, write: if isAdmin();
    }

    // ── Default deny ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
